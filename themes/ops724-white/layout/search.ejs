<% const searchLang = page_lang(page) === 'en' ? 'en' : 'zh-cn' %>
<% const labels = { loading: __('ui.search_loading'), empty: __('ui.search_empty'), error: __('ui.search_error') } %>
<section class="content-section">
  <header class="section-heading">
    <h1><%= page.title %></h1>
    <p class="section-copy"><%= __('ui.search_hint') %></p>
  </header>
  <div class="search" data-search data-language="<%= searchLang %>" data-labels="<%= JSON.stringify(labels) %>">
    <label class="search-label" for="search-input"><%= __('ui.search_placeholder') %></label>
    <input
      class="search-input"
      id="search-input"
      type="search"
      autocomplete="off"
      placeholder="<%= __('ui.search_placeholder') %>"
    >
    <p class="search-status" data-search-status hidden></p>
    <ul class="search-results" data-search-results></ul>
  </div>
  <noscript>
    <p class="empty-state"><%= __('ui.search_noscript') %></p>
  </noscript>
  <script src="<%- url_for('/js/search.js') %>" defer></script>
</section>
