<header class="site-header">
  <div class="site-header-inner">
    <div class="site-header-profile">
      <a class="site-avatar-link" href="<%- url_for('/') %>" aria-label="<%= config.title %>">
        <span class="site-avatar" aria-hidden="true"></span>
      </a>
      <div class="site-identity">
        <a class="site-brand" href="<%- url_for('/') %>"><%= config.title %></a>
        <% if (config.subtitle) { %>
          <p class="site-tagline"><%= config.subtitle %></p>
        <% } %>
      </div>
    </div>
    <% const currentLang = page_lang(page) %>
    <% const langPrefix = currentLang === 'en' ? '/en' : '' %>
    <nav class="site-nav" aria-label="Main">
      <a href="<%- url_for(`${langPrefix}/`) %>"><%= __('nav.home') %></a>
      <a href="<%- url_for(`${langPrefix}/life/`) %>"><%= __('nav.life') %></a>
      <a href="<%- url_for(`${langPrefix}/categories/`) %>"><%= __('nav.categories') %></a>
      <a href="<%- url_for(`${langPrefix}/tags/`) %>"><%= __('nav.tags') %></a>
      <a href="<%- url_for(`${langPrefix}/archives/`) %>"><%= __('nav.archives') %></a>
      <a href="<%- url_for(`${langPrefix}/about/`) %>"><%= __('nav.about') %></a>
    </nav>
    <div class="site-header-locale">
      <%- partial('partials/language-switcher') %>
    </div>
  </div>
</header>
