<header class="site-header">
  <div class="site-header-inner">
    <div class="site-header-profile">
      <a class="site-avatar-link" href="<%- url_for('/') %>" aria-label="<%= config.title %>">
        <span class="site-avatar" aria-hidden="true"></span>
      </a>
      <div class="site-identity">
        <a class="site-brand" href="<%- url_for('/') %>"><%= config.title %></a>
        <% if (config.subtitle) { %>
          <p class="site-tagline"><%= config.subtitle %></p>
        <% } %>
      </div>
    </div>
    <nav class="site-nav" aria-label="Main">
      <a href="<%- url_for('/') %>"><%= __('nav.home') %></a>
      <a href="<%- url_for('/about/') %>"><%= __('nav.about') %></a>
    </nav>
  </div>
</header>
