<% const social = site.data.social || {} %>
<% const socialLinks = social.links || [] %>
<% const currentLang = page_lang(page) %>
<% const feedPath = currentLang === 'en' ? '/en/atom.xml' : '/atom.xml' %>
<% const icp = profile_value('icp') %>
<footer class="site-footer">
  <ul class="social-links">
    <% socialLinks.forEach(function (link) { %>
      <li><a href="<%- link.url %>" rel="noopener"><%= link.label %></a></li>
    <% }) %>
    <li><a href="<%- url_for(feedPath) %>" rel="alternate" type="application/atom+xml"><%= __('ui.subscribe') %></a></li>
  </ul>
  <p>© <%= date(new Date(), 'YYYY') %> <%= site_title(page) %></p>
  <% if (icp) { %>
    <p class="site-footer-beian">
      <a href="https://beian.miit.gov.cn/" rel="noopener" target="_blank"><%= icp %></a>
    </p>
  <% } %>
</footer>
