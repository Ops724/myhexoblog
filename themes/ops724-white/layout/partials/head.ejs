<% const siteName = site_title(page) %>
<% const favicon = profile_value('favicon') %>
<% const currentLang = page_lang(page) %>
<% const feedPath = currentLang === 'en' ? '/en/atom.xml' : '/atom.xml' %>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><% if (page.title && page.title !== siteName) { %><%= page.title %> · <% } %><%= siteName %></title>
<meta name="description" content="<%= config.description %>">
<% if (favicon) { %>
<link rel="icon" href="<%- url_for(favicon) %>">
<% } %>
<link rel="alternate" type="application/atom+xml" title="<%= siteName %>" href="<%- url_for(feedPath) %>">
<link rel="stylesheet" href="<%- url_for('/css/tokens.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/base.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/layout.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/components.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/content.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/photos.css') %>">
