<article class="article article-album">
  <header class="article-header">
    <h1><%= page.title %></h1>
    <%- partial('partials/post-meta') %>
    <%- partial('partials/translation-link') %>
  </header>
  <% if (page.content) { %>
    <div class="article-body album-intro">
      <%- page.content %>
    </div>
  <% } %>
  <%- partial('partials/photo-pile', { photos: page.photos, captions: page.captions }) %>
  <%- partial('partials/pagination', { neighbors: post_neighbors(page) }) %>
</article>
<script src="<%- url_for('/js/photos.js') %>" defer></script>
